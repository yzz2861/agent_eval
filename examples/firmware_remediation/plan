#!/usr/bin/env python3
"""Offline firmware remediation planner example.

The example creates two signed repository views in a temporary directory:

* ``archive`` contains the withdrawn 1.0.0 common firmware and the known-good
  spare firmware 0.9.0.
* ``current`` contains the 1.1.0 monitoring firmware.

Both example devices have 1.0.0 installed. The monitoring group can move
forward, while the spare group can only take the controlled rollback route
described by the caller supplied compatibility table.
"""

from __future__ import annotations

import argparse
import json
import tempfile
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any

from securesystemslib.signer import CryptoSigner, Signer

from tuf.api.metadata import (
    TOP_LEVEL_ROLE_NAMES,
    DelegatedRole,
    Delegations,
    MetaFile,
    Metadata,
    Root,
    Snapshot,
    TargetFile,
    Targets,
    Timestamp,
)
from tuf.api.serialization.json import JSONSerializer
from tuf.ngclient.remediation import (
    CompatibilityTable,
    Device,
    RemediationPlanner,
    VerifiedTargetView,
)

HERE = Path(__file__).resolve().parent
EXPIRES = datetime.now(UTC) + timedelta(days=3650)


def _target(path: str, custom: dict[str, Any]) -> TargetFile:
    target = TargetFile.from_data(path, b"firmware:" + path.encode())
    target.unrecognized_fields["custom"] = custom
    return target


def _write_view(
    directory: Path,
    *,
    top_targets: dict[str, dict[str, Any]],
    delegated_targets: dict[str, dict[str, Any]],
    snapshot_version: int,
    role_version: int,
) -> None:
    signers: dict[str, Signer] = {
        role: CryptoSigner.generate_ed25519()
        for role in [*TOP_LEVEL_ROLE_NAMES, "firmware"]
    }

    root = Root(expires=EXPIRES)
    for role in TOP_LEVEL_ROLE_NAMES:
        root.add_key(signers[role].public_key, role)
    root_md = Metadata(root)
    root_md.sign(signers[Root.type])

    firmware_key = signers["firmware"].public_key
    delegations = Delegations(
        {firmware_key.keyid: firmware_key},
        {
            "firmware": DelegatedRole(
                "firmware",
                [firmware_key.keyid],
                1,
                False,
                paths=["firmware/*"],
            )
        },
    )
    top = Targets(
        expires=EXPIRES,
        targets={
            path: _target(path, custom)
            for path, custom in top_targets.items()
        },
        delegations=delegations,
    )
    top_md = Metadata(top)
    top_md.sign(signers[Targets.type])
    top_bytes = top_md.to_bytes(JSONSerializer())

    delegated = Targets(
        version=role_version,
        expires=EXPIRES,
        targets={
            path: _target(path, custom)
            for path, custom in delegated_targets.items()
        },
    )
    role_md = Metadata(delegated)
    role_md.sign(signers["firmware"])
    role_bytes = role_md.to_bytes(JSONSerializer())

    snapshot = Snapshot(
        version=snapshot_version,
        expires=EXPIRES,
        meta={
            "targets.json": MetaFile.from_data(
                top.version, top_bytes, ["sha256"]
            ),
            "firmware.json": MetaFile.from_data(
                delegated.version, role_bytes, ["sha256"]
            ),
        },
    )
    snapshot_md = Metadata(snapshot)
    snapshot_md.sign(signers[Snapshot.type])
    snapshot_bytes = snapshot_md.to_bytes(JSONSerializer())

    timestamp = Timestamp(
        expires=EXPIRES,
        snapshot_meta=MetaFile.from_data(
            snapshot.version, snapshot_bytes, ["sha256"]
        ),
    )
    timestamp_md = Metadata(timestamp)
    timestamp_md.sign(signers[Timestamp.type])

    files = {
        "root.json": root_md.to_bytes(JSONSerializer()),
        "timestamp.json": timestamp_md.to_bytes(JSONSerializer()),
        "snapshot.json": snapshot_bytes,
        "targets.json": top_bytes,
        "firmware.json": role_bytes,
    }
    directory.mkdir(parents=True)
    for filename, data in files.items():
        (directory / filename).write_bytes(data)


def _load_devices(path: Path) -> list[Device]:
    raw = json.loads(path.read_text(encoding="utf-8"))
    return [
        Device(
            device_id=item["device_id"],
            group=item["group"],
            installed_version=item["installed_version"],
        )
        for item in raw
    ]


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--json",
        action="store_true",
        help="print the machine readable plan instead of a table",
    )
    args = parser.parse_args()

    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        archive_dir = base / "archive"
        current_dir = base / "current"

        _write_view(
            archive_dir,
            top_targets={
                "firmware/common-1.0.0.bin": {
                    "version": "1.0.0",
                    "uses": ["install", "rollback"],
                    "withdrawn": True,
                }
            },
            delegated_targets={
                "firmware/spare-0.9.0.bin": {
                    "version": "0.9.0",
                    "uses": ["rollback"],
                    "review_status": "pending",
                }
            },
            snapshot_version=4,
            role_version=2,
        )
        _write_view(
            current_dir,
            top_targets={
                "firmware/monitor-1.1.0.bin": {
                    "version": "1.1.0",
                    "uses": ["install"],
                }
            },
            delegated_targets={},
            snapshot_version=9,
            role_version=3,
        )

        archive = VerifiedTargetView.from_directory(
            "archive", archive_dir, kind="archive", allow_expired=True
        )
        current = VerifiedTargetView.from_directory("current", current_dir)
        compatibility = CompatibilityTable.from_json_file(
            HERE / "compatibility.json"
        )
        planner = RemediationPlanner([current, archive], compatibility)
        plan = planner.plan(_load_devices(HERE / "devices.json"))

    if args.json:
        print(json.dumps(plan.to_dict(), indent=2, sort_keys=True))
    else:
        print(plan.render())


if __name__ == "__main__":
    main()
