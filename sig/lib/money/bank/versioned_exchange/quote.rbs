class Money
  module Bank
    class VersionedExchange < Base
      # An immutable snapshot of a conversion quoted by
      # +Money::Bank::VersionedExchange#quote+.
      class Quote
        # A single conversion leg of a quote.
        class Hop < Struct[untyped]
        end

        attr_reader from: Money

        attr_reader to_currency: Money::Currency

        attr_reader at: untyped

        attr_reader hops: Array[Hop]

        def initialize: (from: Money, to_currency: Money::Currency | string | Symbol, at: untyped, hops: Array[Hop], ?rounding_method: ^(BigDecimal) -> Integer) -> void

        def path: () -> Array[string]

        def rate: () -> BigDecimal

        def exact_fractional: () -> BigDecimal

        def amount: () -> Money

        def recalculate: () -> Money

        def to_h: () -> Hash[Symbol, untyped]
      end
    end
  end
end

